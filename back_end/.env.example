# back_end/.env

# PROJECT INIT
PROJECT_NAME=Body_Fat_Percentage_Predictor
PROJECT_VERSION=1.0.0

# APP START UP
APP_MAIN=main:app
APP_HOST=0.0.0.0
APP_PORT=8000

# API URLS
API_V1_STR=/api
APP_BASE_URL=http://localhost:8000
API_PREFIX='/api'

# API SECURITY
API_KEY=replace-me
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000","http://localhost:5173"]'
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
ALLOW_METHODS='["POST","GET","OPTIONS"]'
ALLOW_HEADERS='["X-API-Key","Content-Type"]'
EXPOSE_HEADERS='["*"]'
MAX_AGE=600
CALLS_PER_MINUTE=60

# DEVELOPMENT
ENVIRONMENT=production
DEBUG=False
DOCS=False

# DB CREDENTIALS
POSTGRES_DB=replace-me
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=replace-me
POSTGRES_PORT=replace-me
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}

# DB ATTRIBUTES
DB_SSL_MODE=disable
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# DB INSTANCES
REQUIRED_TABLES='["prediction_history","prediction_feedback"]'

# MODELS
MODEL_VERSION=1.0.0